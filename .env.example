# Google Cloud project for deploy.sh (Cloud Run, us-west1)
GCP_PROJECT_ID=your-gcp-project-id

# Primary LLM: OpenAI (Chat Completions). Leave OPENAI_BASE_URL unset for OpenAI itself.
OPENAI_API_KEY=your-openai-key-here
MODEL_NAME=gpt-6-sol

# Fallback LLM: NVIDIA NIM (OpenAI-compatible endpoint), used if the primary fails
NIM_API_KEY=your-nim-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Tavily Search MCP
TAVILY_API_KEY=your-tavily-key-here

# USDA FoodData Central, used by the nutrition-lookup MCP server
USDA_API_KEY=your-usda-key-here
